{
  "name": "dispatch-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del módulo Dispatch (planificación de ciclos operativos)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:schema": "tsx src/database/runSql.ts schema",
    "db:seed": "tsx src/database/runSql.ts seed",
    "db:reset": "tsx src/database/runSql.ts schema seed",
    "db:schema:prod": "node dist/database/runSql.js schema",
    "db:seed:prod": "node dist/database/runSql.js seed",
    "db:reset:prod": "node dist/database/runSql.js schema seed",
    "db:start": "tsx src/database/localPostgres.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
