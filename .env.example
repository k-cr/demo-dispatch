# ---------------------------------------------------------------------------
#  DISPATCH · Variables de entorno
#  Copie este archivo a ".env" (raíz del proyecto o backend/) y ajuste valores.
# ---------------------------------------------------------------------------

# ---- PostgreSQL (usadas por docker-compose) --------------------------------
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=dispatch
POSTGRES_DB=dispatch
POSTGRES_PORT=5432

# ---- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
DB_SCHEMA=dispatch
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173
# Zona horaria de la operación: define inicio de turnos y jornadas
OPERATION_TIMEZONE=America/Argentina/San_Juan
# LISTEN/NOTIFY de PostgreSQL → bus de eventos (base para WebSocket)
REALTIME_PG_LISTEN=true

# ---- Frontend (Vite) -------------------------------------------------------
# URL base de la API. Vacío = usa el proxy de Vite (/api → http://localhost:4000)
VITE_API_URL=
# Segundos entre consultas de cambios (polling)
VITE_POLL_SECONDS=15
