# =============================================================================
# DISPATCH DEMO · Variables de Entorno para Coolify
# =============================================================================
# Copie o configure estas variables en el panel de Coolify para su aplicación
# o stack de Docker Compose.
# =============================================================================

# ---- Base de Datos PostgreSQL (Servicio "db" en Compose) --------------------
# Credenciales para el contenedor PostgreSQL creado por docker-compose:
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=cambiar_por_contrasena_segura_123
POSTGRES_DB=dispatch
POSTGRES_PORT=5432

# ---- Backend API (Servicio "backend") ---------------------------------------
NODE_ENV=production
PORT=4000

# Cadena de conexión:
# Opción A (Stack Docker Compose): usa el host interno "db"
DATABASE_URL=postgres://dispatch:cambiar_por_contrasena_segura_123@db:5432/dispatch

# Opción B (Si usa una base de datos PostgreSQL gestionada de Coolify):
# DATABASE_URL=postgres://usuario:contrasena@postgres-host-en-coolify:5432/dispatch
# DATABASE_SSL=false

DB_SCHEMA=dispatch

# Dominios permitidos para CORS (separados por coma, o * para permitir todos)
# Ejemplo: https://dispatch.tudominio.com,https://api-dispatch.tudominio.com
CORS_ORIGIN=*

# Zona horaria de operaciones (San Juan / Argentina para turnos de minería)
OPERATION_TIMEZONE=America/Argentina/San_Juan

# Listener de eventos LISTEN/NOTIFY en PostgreSQL (tiempo real)
REALTIME_PG_LISTEN=true

# Opciones de auto-migración al iniciar el backend:
# Ponga en true en el primer despliegue si está conectando a una base de datos
# externa o gestionada de Coolify para crear las tablas y catálogos automáticamente.
AUTO_MIGRATE=false
AUTO_SEED=false

# ---- Frontend (Servicio "frontend") -----------------------------------------
FRONTEND_PORT=80

# URL interna hacia el backend para el proxy inverso de Nginx:
BACKEND_URL=http://backend:4000

# (Opcional) Solo si el frontend y el backend están en dominios completamente
# separados y no desea usar el proxy interno de Nginx:
# VITE_API_URL=https://api-dispatch.tudominio.com
